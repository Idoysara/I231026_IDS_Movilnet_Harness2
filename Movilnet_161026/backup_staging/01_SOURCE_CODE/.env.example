# Ejemplo de Variables de Entorno para Movilnet AI Engine
# Renombrar este archivo a .env y agregar la clave oficial de Google AI Studio

# Clave oficial de Google AI Studio (Gemini)
GEMINI_API_KEY=tu_clave_de_google_aistudio_aqui
AISTUDIO_API_KEY=tu_clave_de_google_aistudio_aqui

# Modelo activo de Gemini
MOVILNET_LLM_MODEL=gemini-3.5-flash-lite

# (Opcional) Pasarela de modelos OpenRouter para contingencia multi-proveedor
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Conexión n8n LPGTEC & Webhook Bridge
N8N_BASE_URL=https://n8n.lpgtec.net
N8N_API_KEY=tu_api_key_de_n8n_aqui
N8N_MCP_URL=https://n8n.lpgtec.net/mcp-server/http
N8N_MCP_TOKEN=tu_token_mcp_aqui
MOVILNET_CORE_URL=http://localhost:8010


# Parametrización Central de Línea Oficial del Bot (Modelo N <-> 1)
MOVILNET_ACTIVE_BOT_PHONE=0424-1533712
MOVILNET_BOT_NAME=MOVI

# Render 1-Click Deploy Hook & Public PWA
RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-tu_servicio?key=tu_key
MOVILNET_PUBLIC_PWA_URL=https://movilnet-core.onrender.com
